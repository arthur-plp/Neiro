# Copie ce fichier en .env.local et remplis les valeurs depuis ton projet Supabase.
# .env.local est ignoré par git et ne doit JAMAIS être committé.

# --- Exposées au navigateur (préfixe NEXT_PUBLIC_) ---
# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > anon / public
# Soumise à la Row Level Security : sans danger côté client, c'est son rôle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Serveur uniquement ---
# Supabase > Project Settings > Database > Connection string > URI
# Contient le mot de passe de la base. Utilisée uniquement par drizzle-kit
# pour appliquer les migrations, jamais par l'application à l'exécution.
DATABASE_URL=

# Supabase > Project Settings > API Keys > service_role
# CONTOURNE LA ROW LEVEL SECURITY. Ne doit jamais être exposée au navigateur
# ni préfixée NEXT_PUBLIC_. Aucune ligne de code ne l'utilise aujourd'hui :
# elle est réservée à d'éventuelles Edge Functions (calcul de badges,
# extraction de PDF de billet). Laisse-la vide tant qu'elle n'est pas requise.
SUPABASE_SERVICE_ROLE_KEY=
